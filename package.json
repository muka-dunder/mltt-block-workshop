{
  "name": "mltt-block-workshop",
  "version": "0.0.4",
  "private": true,
  "description": "A bilingual Blockly workshop for Martin-Lof type theory with real-time bidirectional type checking.",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "demo": "node tools/cli/demo.js",
    "lint": "eslint . --max-warnings 0",
    "test": "node test/test.js",
    "test:all": "node test/test.js && node test/declarations.js && node test/custom.js && node test/rules.js && node test/containers.js && node test/entry.js && node test/contexts.js && node test/eliminators.js",
    "test:ui": "node tools/browser/i18n-test.js",
    "test:release": "node test/release.mjs",
    "test:release:ui": "node tools/browser/versioned-site-test.cjs",
    "build": "vite build",
    "package:zip": "npm run build && node tools/release/package.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=22.0.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "playwright": "1.56.1",
    "vite": "6.4.6"
  },
  "dependencies": {
    "@mit-app-inventor/blockly-block-lexical-variables": "11.0.3",
    "blockly": "11.2.2",
    "fflate": "0.8.3"
  }
}
